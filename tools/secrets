#!/usr/bin/env python3
"""secrets: fleetkit's secrets command line (ADR-0009, ADR-0017). Works on a
secrets data repository (a flake made with fleetkit.lib.secrets.mkData); never
prints a secret value.

  secrets check   [--repo DIR] [--report FILE]
      .sops.yaml matches the registry, no plaintext, every registry key exists
      in its file, every reader is a recipient (tools/secrets-check.py).
  secrets render  [--repo DIR] [--report FILE] [--stdout]
      write .sops.yaml from the registry (public keys only).
  secrets scan    [--all]
      the secret-pattern scan over staged changes (--all: every tracked file).
  secrets edit FILE
      sops edit FILE (refused for protected files).
  secrets host add ID ADDRESS [--kind guest|node] [--port N] [--hosts-file F] [--no-rekey]
      fetch the host's ed25519 key (ssh-keyscan), record it in hosts.json,
      re-render .sops.yaml, and `sops updatekeys` the files it reads.
  secrets rekey   [FILE ...] [--dry-run]
      `sops updatekeys` FILEs, or every sops file whose recipients differ from
      its rule. Protected files are never re-encrypted.
  secrets refs --flake REF [--prefix P] [SYSTEM ...]
      every sops secret a system declares exists in its file (tools/secrets-refs.py).
  secrets import SOPS_YAML [--estate E] [--prefix P] [--root R]
      print a hand-written .sops.yaml as an estate's secrets.layout (Nix).
  secrets deploy-key ...      tools/deploy-key
  secrets app-bootstrap ...   tools/github-app-bootstrap

The registry's report is read with `nix eval --json <repo>#report.check`, or
from --report FILE, or from the command in $SECRETS_EVAL (given the repo as its
argument, it prints the report JSON). updatekeys and edit need an operator's
age key; nothing here decrypts to stdout or to a file.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
TOOL = {
    "sops-config": os.path.join(HERE, "sops-config.py"),
    "check": os.path.join(HERE, "secrets-check.py"),
    "refs": os.path.join(HERE, "secrets-refs.py"),
    "scan": os.path.join(HERE, "hooks", "secrets-scan.sh"),
    "deploy-key": os.path.join(HERE, "deploy-key"),
    "app-bootstrap": os.path.join(HERE, "github-app-bootstrap"),
}
SSH = re.compile(r"^ssh-ed25519 AAAA[A-Za-z0-9+/]+={0,2}$")


def die(msg, code=2):
    print(f"secrets: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    print(f"secrets: {msg}", file=sys.stderr)


def py(tool, *args, **kw):
    return subprocess.run([sys.executable, TOOL[tool], *args], **kw)


def load(name):
    import importlib.util
    spec = importlib.util.spec_from_file_location(name.replace("-", "_"), TOOL[name])
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def repo_dir(a):
    d = os.path.abspath(a.repo or ".")
    if not os.path.isfile(os.path.join(d, "flake.nix")) and not (a.report or os.environ.get("SECRETS_EVAL")):
        die(f"{d} has no flake.nix; run in a data repository or pass --repo")
    return d


def report(a, repo):
    if getattr(a, "report", None):
        return json.load(open(a.report))
    cmd = os.environ.get("SECRETS_EVAL")
    argv = [cmd, repo] if cmd else ["nix", "eval", "--json", f"{repo}#report.check"]
    r = subprocess.run(argv, capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr[-4000:])
        die("could not evaluate the registry's report")
    return json.loads(r.stdout)


def write_report(rep):
    f = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
    json.dump(rep, f)
    f.close()
    return f.name


def protected(rep, path):
    return any(re.search(rx, path) for rx in rep["sopsConfig"].get("protect", []))


def render(rep, repo, stdout=False):
    text = load("sops-config").render_config(rep["sopsConfig"], "ssh-to-age")
    if stdout:
        sys.stdout.write(text)
        return
    path = os.path.join(repo, ".sops.yaml")
    old = open(path).read() if os.path.isfile(path) else None
    if old == text:
        note(".sops.yaml: unchanged")
        return
    with open(path, "w") as f:
        f.write(text)
    note("wrote .sops.yaml")


def drifted(rep, repo, only=None):
    """[(path, missing names, stale count)] for sops files whose recipients differ from their rule."""
    chk = load("check")
    _, keys, rules = load("sops-config").build_config(rep["sopsConfig"], "ssh-to-age")
    compiled = [(re.compile(rx), names) for rx, names in rules]
    out = []
    for path in (only if only is not None else chk.repo_files(repo)):
        full = os.path.join(repo, path)
        if path == ".sops.yaml" or not os.path.isfile(full):
            continue
        text = chk.read(full)
        kind = chk.fmt(path)
        if not chk.is_sops(text, kind if kind != "binary" else "json"):
            continue
        names = next((ns for c, ns in compiled if c.search(path)), None)
        if names is None:
            continue
        want = {keys[n]: n for n in names if n in keys}
        have = set(chk.AGE.findall(text))
        missing = sorted(n for k, n in want.items() if k not in have)
        stale = len(have - set(want))
        out.append((path, missing, stale))
    return out


def updatekeys(rep, repo, paths, dry_run=False):
    rc = 0
    for p in paths:
        if protected(rep, p):
            note(f"{p}: protected (sopsConfig.protect), not re-encrypted")
            continue
        if dry_run:
            print(p)
            continue
        r = subprocess.run(["sops", "updatekeys", "-y", p], cwd=repo, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE, text=True)
        if r.returncode != 0:
            rc = 1
            note(f"{p}: sops updatekeys failed (exit {r.returncode}): {r.stderr.strip()[-300:]}")
        else:
            note(f"{p}: re-keyed")
    return rc


def cmd_check(a):
    repo = repo_dir(a)
    f = write_report(report(a, repo))
    try:
        r = py("check", "--report", f, "--root", repo)
    finally:
        os.unlink(f)
    sys.exit(r.returncode)


def cmd_render(a):
    repo = repo_dir(a)
    render(report(a, repo), repo, a.stdout)


def cmd_scan(a):
    sys.exit(subprocess.run(["bash", TOOL["scan"], *(["--all"] if a.all else [])]).returncode)


def cmd_edit(a):
    repo = os.path.abspath(a.repo or ".")
    path = os.path.relpath(os.path.abspath(a.file), repo)
    pats = []
    if os.environ.get("SECRETS_EVAL") or os.path.isfile(os.path.join(repo, "flake.nix")):
        pats = report(a, repo)["sopsConfig"].get("protect", [])
    if any(re.search(rx, path) for rx in pats):
        die(f"{path} is protected (sopsConfig.protect): it moves only as bytes")
    os.execvp("sops", ["sops", "edit", a.file])


def keyscan(a):
    argv = (a.keyscan.split() if a.keyscan else ["ssh-keyscan"]) + ["-t", "ed25519", "-p", str(a.port), a.address]
    r = subprocess.run(argv, capture_output=True, text=True)
    keys = set()
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1] == "ssh-ed25519":
            keys.add(f"{parts[1]} {parts[2]}")
    if len(keys) != 1:
        die(f"ssh-keyscan of {a.address} gave {len(keys)} ed25519 key(s) (exit {r.returncode}); "
            "check the address and that sshd runs")
    key = keys.pop()
    if not SSH.match(key):
        die("ssh-keyscan returned something that is not an ed25519 public key")
    return key


def cmd_host_add(a):
    if not re.fullmatch(r"[^/\s]+/[^\s]+", a.id):
        die(f"host id {a.id!r}: use <estate or site>/<name>")
    repo = repo_dir(a)
    hosts_file = os.path.join(repo, a.hosts_file)
    key = keyscan(a)
    r = subprocess.run(["ssh-to-age"], input=key + "\n", capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip().startswith("age1"):
        die(f"ssh-to-age could not convert the key: {r.stderr.strip()}")
    age = r.stdout.strip()
    note(f"{a.id}: {key}")
    note(f"{a.id}: age recipient {age}")
    note("verify that key out of band (on the host: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub)")
    hosts = json.load(open(hosts_file)) if os.path.isfile(hosts_file) else {}
    entry = {"ed25519": key}
    if a.kind != "guest":
        entry["kind"] = a.kind
    old = hosts.get(a.id)
    hosts[a.id] = entry
    with open(hosts_file, "w") as f:
        json.dump(dict(sorted(hosts.items())), f, indent=2)
        f.write("\n")
    note(f"{a.hosts_file}: {'updated' if old else 'added'} {a.id}")
    rep = report(a, repo)
    render(rep, repo)
    anchors = [e.get("prefix", "") + n for e in rep["sopsConfig"]["estates"]
               for n, x in (e.get("model") or {}).get("anchors", {}).items() if x.get("id") == a.id]
    if not anchors:
        note(f"no file names {a.id} as a reader: add it to a file's readers in the registry, "
             "then `secrets render` and `secrets rekey`")
        return
    _, _, rules = load("sops-config").build_config(rep["sopsConfig"], "ssh-to-age")
    mine = [rx for rx, names in rules if set(names) & set(anchors)]
    files = [p for p, missing, stale in drifted(rep, repo)
             if any(re.search(rx, p) for rx in mine) and (missing or stale)]
    if a.no_rekey:
        note("--no-rekey: run `secrets rekey` to re-key: " + ", ".join(files))
        return
    sys.exit(updatekeys(rep, repo, files))


def cmd_rekey(a):
    repo = repo_dir(a)
    rep = report(a, repo)
    if a.files:
        paths = [os.path.relpath(os.path.abspath(f), repo) for f in a.files]
    else:
        paths = [p for p, missing, stale in drifted(rep, repo) if missing or stale]
        if not paths:
            note("every sops file is encrypted to exactly its rule's recipients; nothing to re-key")
            return
    sys.exit(updatekeys(rep, repo, paths, a.dry_run))


def cmd_refs(a):
    argv = ["--flake", a.flake] + (["--prefix", a.prefix] if a.prefix else []) + a.systems
    sys.exit(py("refs", *argv).returncode)


def nix_str(s):
    return json.dumps(s).replace("${", "\\${")


def cmd_import(a):
    lay = load("sops-config").import_layout(a.file)
    out = [f"fleet.estates.{a.estate}.secrets.layout = {{",
           f"  prefix = {nix_str(a.prefix)};",
           f"  root = {nix_str(a.root)};",
           "  keys = ["]
    out += [f"    {{ name = {nix_str(k['name'])}; age = {nix_str(k['age'])}; }}" for k in lay["keys"]]
    out += ["  ];", "  rules = ["]
    for r in lay["rules"]:
        names = " ".join(nix_str(n) for n in r["anchors"])
        out.append(f"    {{ pathRegex = {nix_str(r['pathRegex'])}; anchors = [ {names} ]; }}")
    out += ["  ];", "};"]
    print("\n".join(out))


def main():
    p = argparse.ArgumentParser(prog="secrets", description=__doc__.split("\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def withrepo(c, rep=True):
        c.add_argument("--repo", help="the data repository (default: .)")
        if rep:
            c.add_argument("--report", help="report.check JSON instead of evaluating the repository")
        return c

    withrepo(sub.add_parser("check", help="check the data repository")).set_defaults(fn=cmd_check)
    c = withrepo(sub.add_parser("render", help="write .sops.yaml from the registry"))
    c.add_argument("--stdout", action="store_true", help="print instead of writing .sops.yaml")
    c.set_defaults(fn=cmd_render)
    c = sub.add_parser("scan", help="secret-pattern scan of staged changes")
    c.add_argument("--all", action="store_true", help="every tracked file")
    c.set_defaults(fn=cmd_scan)
    c = withrepo(sub.add_parser("edit", help="sops edit a file"))
    c.add_argument("file")
    c.set_defaults(fn=cmd_edit)
    h = sub.add_parser("host", help="host keys").add_subparsers(dest="hcmd", required=True)
    c = withrepo(h.add_parser("add", help="record a host's key and re-key the files it reads"))
    c.add_argument("id", help="<estate>/<name> (guest) or <site>/<name> (node)")
    c.add_argument("address", help="where ssh-keyscan reaches the host")
    c.add_argument("--kind", choices=["guest", "node"], default="guest")
    c.add_argument("--port", type=int, default=22)
    c.add_argument("--hosts-file", default="hosts.json")
    c.add_argument("--no-rekey", action="store_true")
    c.add_argument("--keyscan", help=argparse.SUPPRESS)
    c.set_defaults(fn=cmd_host_add)
    c = withrepo(sub.add_parser("rekey", help="sops updatekeys files whose recipients drifted"))
    c.add_argument("files", nargs="*")
    c.add_argument("--dry-run", action="store_true", help="list the files only")
    c.set_defaults(fn=cmd_rekey)
    c = sub.add_parser("refs", help="every secret a system reads exists")
    c.add_argument("--flake", required=True)
    c.add_argument("--prefix", default="")
    c.add_argument("systems", nargs="*")
    c.set_defaults(fn=cmd_refs)
    c = sub.add_parser("import", help="a hand-written .sops.yaml as secrets.layout (Nix)")
    c.add_argument("file")
    c.add_argument("--estate", default="ESTATE")
    c.add_argument("--prefix", default="")
    c.add_argument("--root", default="")
    c.set_defaults(fn=cmd_import)
    # Handled before parsing (their arguments are passed on as they are).
    sub.add_parser("deploy-key", help="tools/deploy-key", add_help=False)
    sub.add_parser("app-bootstrap", help="tools/github-app-bootstrap", add_help=False)
    if len(sys.argv) > 1 and sys.argv[1] in ("deploy-key", "app-bootstrap"):
        os.execv(sys.executable, [sys.executable, TOOL[sys.argv[1]], *sys.argv[2:]])
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
