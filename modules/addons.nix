# fleet.estates.<estate>.addons: what an estate switches on beyond the kit's
# own providers. Each add-on is off by default, and an estate that switches
# none on renders exactly as before (lib/terraform.nix adds nothing for it).
# Extends the estate submodule declared in ./estates.nix.
#
# addons.ansible: playbook runs against the estate's guests, rendered as
# ansible_playbook resources of the ansible/ansible provider (pinned in
# providers/) in the estate's guests stack, each after its guest's resource;
# lib/ansible.nix renders them, docs/addons.md says how a deploy runs them.
# A playbook is a Nix path or derivation: the runner runs what was evaluated,
# from the store. Secrets reach a playbook as paths of files on the runner,
# never as values.
{ lib, config, ... }:
let
  inherit (lib) types mkOption;

  # The collections the runner's Ansible has (packages.<system>.ansible),
  # generated by tests/gen_ansible_collections.py.
  bundled = lib.importJSON ../providers/ansible/collections.json;
  available = bundled.builtin ++ lib.attrNames bundled.collections;

  # Extra variables fleetkit sets itself: the guest's address and SSH user,
  # and `hostname`, which the provider passes on every run (-e hostname=).
  reserved = [
    "ansible_host"
    "ansible_user"
    "hostname"
  ];

  playbookType = types.submodule {
    options = {
      guest = mkOption {
        type = types.str;
        description = "The guest the playbook runs against: its name in this estate (fleet.guests.<estate>.<name>). Its address on `network` is ansible_host; the run comes after the guest's resource when the guest is managed.";
      };
      playbook = mkOption {
        type = types.path;
        description = "The playbook: a Nix path or derivation, a playbook file or a directory holding one (then `entry` names it). It is copied to or built in the store, and the deploy runs that store path.";
      };
      entry = mkOption {
        type = types.nullOr types.str;
        default = null;
        example = "site.yml";
        description = "The playbook file inside `playbook` when that is a directory, relative to it. null = `playbook` is the playbook file.";
      };
      collections = mkOption {
        type = types.listOf types.str;
        default = [ ];
        example = [
          "vyos.vyos"
          "ansible.netcommon"
        ];
        description = "The Ansible collections the playbook uses. Each must be one the runner's Ansible has (providers/ansible/collections.json); nothing is installed at deploy time.";
      };
      network = mkOption {
        type = types.str;
        default = "lan";
        description = "The network NAME whose static address of the guest is ansible_host.";
      };
      user = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "The SSH user (ansible_user). null = the estate's colmena.targetUser, else root: the user every deploy of the estate logs in as.";
      };
      groups = mkOption {
        type = types.listOf types.str;
        default = [ ];
        description = "Inventory groups the guest is put in for the run.";
      };
      extraVars = mkOption {
        type = types.attrsOf types.str;
        default = { };
        description = "Extra variables (-e), as strings. They go into the program and the stack's state: never a secret (see secretFiles). ansible_host, ansible_user and hostname are fleetkit's.";
      };
      secretFiles = mkOption {
        type = types.attrsOf types.str;
        default = { };
        example = {
          vyos_password_file = "/run/secrets/vyos-admin";
        };
        description = "Extra variables whose value is the absolute path of a file on the deploy runner that holds a secret (decrypted there, for example by sops-nix). Only the path is rendered; the playbook reads the file (lookup('file', ...)).";
      };
    };
  };

  addonsType = types.submodule {
    options.ansible = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Run Ansible playbooks against the estate's guests as part of its deploy (the ansible/ansible provider in the guests stack).";
      };
      playbooks = mkOption {
        type = types.attrsOf playbookType;
        default = { };
        description = "Playbook runs, by name; the name is the resource's key in the guests stack.";
      };
    };
  };

  inherit (builtins) storeDir;
  isAbs = s: lib.hasPrefix "/" s;
  inStore = s: lib.hasPrefix "${storeDir}/" s;

  playbookAssertions =
    ename: e:
    let
      a = e.addons.ansible;
      at = p: "fleet.estates.${ename}.addons.ansible.${p}";
      guests = config.fleet.guests.${ename} or { };
      colmena = e.colmena or null;
      perPlaybook =
        pname: pb:
        let
          w = p: at "playbooks.${pname}.${p}";
          guest = guests.${pb.guest} or null;
          addr = if guest == null then null else guest.ipv4.${pb.network} or null;
          unknown = lib.filter (c: !lib.elem c available) pb.collections;
          clash = lib.intersectLists (lib.attrNames pb.extraVars) (lib.attrNames pb.secretFiles);
          taken = lib.intersectLists reserved (lib.attrNames pb.extraVars ++ lib.attrNames pb.secretFiles);
          badSecrets = lib.filter (n: !(isAbs pb.secretFiles.${n}) || inStore pb.secretFiles.${n}) (
            lib.attrNames pb.secretFiles
          );
        in
        [
          {
            assertion = guest != null;
            message = "${w "guest"}: \"${pb.guest}\" is not a guest of estate ${ename} (its guests: ${lib.concatStringsSep ", " (lib.attrNames guests)})";
          }
          {
            assertion = guest == null || addr != null;
            message = "${w "network"}: guest ${pb.guest} has no static IPv4 address on network \"${pb.network}\" (it has one on: ${
              lib.concatStringsSep ", " (lib.attrNames (if guest == null then { } else guest.ipv4))
            }); the playbook needs it as ansible_host";
          }
          {
            # Evaluating this copies a path to the store (or instantiates a
            # derivation); a plain string outside the store is refused.
            assertion = inStore "${pb.playbook}";
            message = "${w "playbook"}: \"${toString pb.playbook}\" is not a Nix path or derivation; the deploy runs the playbook from the store, as it was evaluated";
          }
          {
            assertion = pb.entry == null || (!isAbs pb.entry && !lib.elem ".." (lib.splitString "/" pb.entry));
            message = "${w "entry"}: \"${toString pb.entry}\" must be a relative path inside the playbook directory";
          }
          {
            assertion = unknown == [ ];
            message = "${w "collections"}: not in the runner's Ansible (ansible ${bundled.ansible}, providers/ansible/collections.json): ${lib.concatStringsSep ", " unknown}";
          }
          {
            assertion = clash == [ ];
            message = "${w "secretFiles"}: ${lib.concatStringsSep ", " clash} also set in extraVars";
          }
          {
            assertion = taken == [ ];
            message = "${w "extraVars"}: ${lib.concatStringsSep ", " taken} is set by fleetkit (ansible_host and ansible_user from the guest, hostname by the provider)";
          }
          {
            assertion = badSecrets == [ ];
            message = "${w "secretFiles"}: ${lib.concatStringsSep ", " badSecrets}: not an absolute path outside the Nix store; a secret reaches the playbook as a file on the runner, never as a value or through the store";
          }
        ]
        ++ lib.optional (pb.user == null && colmena != null && colmena ? targetUser) {
          assertion = lib.isString colmena.targetUser;
          message = "${w "user"}: null, and the estate's colmena.targetUser is not a string";
        };
    in
    [
      {
        assertion = a.enable || a.playbooks == { };
        message = "${at "playbooks"}: ${lib.concatStringsSep ", " (lib.attrNames a.playbooks)} declared, but addons.ansible.enable is false; an add-on does nothing until the estate switches it on";
      }
    ]
    ++ lib.concatLists (lib.mapAttrsToList perPlaybook a.playbooks);
in
{
  options.fleet.estates = mkOption {
    type = types.attrsOf (
      types.submodule {
        options.addons = mkOption {
          type = addonsType;
          default = { };
          description = "Add-ons the estate switches on (each off by default): docs/addons.md.";
        };
      }
    );
  };

  config.assertions = lib.concatLists (lib.mapAttrsToList playbookAssertions config.fleet.estates);
}
