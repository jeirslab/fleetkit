{
  "targetsData": {
    "docker": {
      "artifact": "tarball/*.tar.xz",
      "description": "Docker/OCI root filesystem of the same template (.tar.xz, docker import)",
      "format": "docker",
      "register": "docker"
    },
    "proxmox-lxc": {
      "artifact": "tarball/*.tar.xz",
      "description": "Proxmox VE LXC container template (.tar.xz, pct/vztmpl)",
      "format": "proxmox-lxc",
      "register": "proxmox-lxc"
    },
    "proxmox-vm": {
      "artifact": "*.vma.zst",
      "description": "Proxmox VE QEMU VM image (vzdump .vma.zst, qmrestore → qm template). Upstream proxmoxVMA/proxmoxImage — the same artifact.",
      "format": "proxmox",
      "register": "proxmox-vm"
    },
    "proxmox-vm-cloud": {
      "artifact": "*.img",
      "description": "Proxmox VE cloud-init VM disk (raw .img; register as a template, clone via a cloud-init drive). Upstream proxmoxCloudImage.",
      "format": "proxmox-cloud",
      "register": "proxmox-vm"
    },
    "xen-orchestra": {
      "artifact": "*.img",
      "description": "Xen Orchestra / XCP-ng UEFI VM disk (raw .img, imported as a VDI → template)",
      "format": "raw-efi",
      "register": "xen-orchestra"
    }
  },
  "templatesData": {
    "docker": {
      "baseName": "nixos-bootstrap",
      "fromTarget": "docker",
      "kind": "container",
      "platform": "docker",
      "tag": "nixos-bootstrap:v1",
      "version": 1
    },
    "proxmox-lxc": {
      "baseName": "nixos-bootstrap-lxc",
      "file": "nixos-bootstrap-lxc-v1.tar.xz",
      "fromTarget": "proxmox-lxc",
      "kind": "lxc",
      "ostype": "nixos",
      "platform": "proxmox",
      "unprivileged": true,
      "version": 1
    },
    "proxmox-vm": {
      "baseName": "nixos-bootstrap-vm",
      "cloudInit": true,
      "firmware": "seabios",
      "fromTarget": "proxmox-vm",
      "kind": "vm",
      "name": "nixos-bootstrap-vm-v1",
      "platform": "proxmox",
      "version": 1,
      "vmid": 9000
    },
    "proxmox-vm-cloud": {
      "baseName": "nixos-bootstrap-cloud",
      "cloudInit": true,
      "firmware": "seabios",
      "fromTarget": "proxmox-vm-cloud",
      "kind": "vm",
      "name": "nixos-bootstrap-cloud-v1",
      "platform": "proxmox",
      "version": 1,
      "vmid": 9001
    },
    "xen-orchestra": {
      "baseName": "nixos-bootstrap-xcpng",
      "firmware": "uefi",
      "fromTarget": "xen-orchestra",
      "kind": "vm",
      "name": "nixos-bootstrap-xcpng-v1",
      "platform": "xen-orchestra",
      "version": 1
    }
  }
}
